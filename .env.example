# Vercel 환경변수 (Project Settings > Environment Variables)
# 실제 값은 Vercel 대시보드 또는 로컬 .env.local 파일에 설정하세요.

# Aiven MySQL 클라우드 DB 연결 정보
DB_HOST=dividendcheck-dividendcheck.j.aivencloud.com
DB_PORT=16264
DB_USER=avnadmin
DB_PASSWORD=your_db_password_here
DB_NAME=defaultdb

# 외부 금융 데이터 API 키
KRX_AUTH_KEY=your_krx_auth_key_here
